    "\n",
    "    cat_cols = ['dow', 'month']\n",
    "    num_cols = [c for c in X_train.columns if c not in ['ds'] + cat_cols]\n",
    "\n",
    "    pre_x = ColumnTransformer(\n",
    "        transformers=[\n",
    "            ('num', Pipeline([\n",
    "                ('imputer', SimpleImputer(strategy='median')),\n",
    "                ('scaler', StandardScaler()),\n",
    "            ]), num_cols),\n",
    "            ('cat', Pipeline([\n",
