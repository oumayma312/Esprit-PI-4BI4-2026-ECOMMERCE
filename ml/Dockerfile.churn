FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-churn.txt /app/requirements-churn.txt
RUN pip install --upgrade pip && pip install -r requirements-churn.txt

COPY . /app

EXPOSE 8001

CMD ["uvicorn", "churn_api:app", "--host", "0.0.0.0", "--port", "8001"]
