{
  "uid": "sougui-ml-observability",
  "title": "Sougui ML Observability",
  "tags": ["sougui", "ml", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "style": "dark",
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Traffic by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (handler)",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Error rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1)",
          "legendFormat": "5xx rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Model health",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "ml_model_metric_value{model=\"supplier_clustering\",metric=\"inertia\"}",
          "legendFormat": "supplier inertia",
          "refId": "A"
        },
        {
          "expr": "ml_model_metric_value{model=\"supplier_clustering\",metric=\"silhouette\"}",
          "legendFormat": "supplier silhouette",
          "refId": "B"
        },
        {
          "expr": "ml_model_metric_value{model=\"supplier_clustering\",metric=\"confidence\"}",
          "legendFormat": "supplier confidence",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Data health",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "ml_data_metric_value{metric=\"missing_ratio\"}",
          "legendFormat": "{{model}} missing ratio",
          "refId": "A"
        },
        {
          "expr": "ml_data_metric_value{metric=\"freshness_seconds\"}",
          "legendFormat": "{{model}} freshness (s)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Model health — sell / promote",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "ml_model_metric_value{model=\"best_time_to_sell\",metric=\"mae\"}",
          "legendFormat": "sell MAE",
          "refId": "A"
        },
        {
          "expr": "ml_model_metric_value{model=\"best_time_to_sell\",metric=\"rmse\"}",
          "legendFormat": "sell RMSE",
          "refId": "B"
        },
        {
          "expr": "ml_model_metric_value{model=\"best_time_to_promote\",metric=\"mae\"}",
          "legendFormat": "promote MAE",
          "refId": "C"
        },
        {
          "expr": "ml_model_metric_value{model=\"best_time_to_promote\",metric=\"rmse\"}",
          "legendFormat": "promote RMSE",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Model health — churn",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "ml_model_metric_value{model=\"churn_prediction\",metric=\"avg_churn_probability\"}",
          "legendFormat": "avg churn prob",
          "refId": "A"
        },
        {
          "expr": "ml_model_metric_value{model=\"churn_prediction\",metric=\"high_risk_rate\"}",
          "legendFormat": "high risk rate",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Drift — distribution shift",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "ml_drift_metric_value{metric=\"distribution_shift\"}",
          "legendFormat": "{{model}} distribution shift",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Drift — precision / accuracy drop",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "ml_drift_metric_value{metric=~\"precision_drop_ratio|accuracy_drop_ratio\"}",
          "legendFormat": "{{model}} {{metric}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Drift — detected flag",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "ml_drift_metric_value{metric=\"detected\"}",
          "legendFormat": "{{model}} drift detected",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Retraining triggers",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        {
          "expr": "increase(ml_retraining_triggers_total[1h])",
          "legendFormat": "{{model}} / {{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    }
  ]
}
