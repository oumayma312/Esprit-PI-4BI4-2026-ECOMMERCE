# PostgreSQL connection used by the ML API
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=pi_bi
PGUSER=postgres
PGPASSWORD=04062003

# Schema and table names used by the API
ML_SCHEMA=ml
ML_SUPPLIER_DATASET_TABLE=supplier
ML_SELL_DATASET_TABLE=sell
ML_PROMOTE_DATASET_TABLE=promote
ML_SUPPLIER_TABLE=supplier_clusters
ML_SELL_TABLE=best_time_to_sell_monthly
ML_PROMOTE_TABLE=best_time_to_promote_monthly

FASTAPI_BASE_URL=http://127.0.0.1:8000
FASTAPI_AUTO_START=1
FASTAPI_START_TIMEOUT_SECONDS=20
FLASK_HOST=0.0.0.0
FLASK_PORT=3000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_PROMOTE_EXPERIMENT_NAME=promote-forecasting
MLFLOW_PROMOTE_MODEL_NAME=promote-demand-forecaster
MLFLOW_CAMPAIGN_EXPERIMENT_NAME=campaign-analytics
MLFLOW_CAMPAIGN_CLASSIFIER_MODEL_NAME=campaign-success-classifier
MLFLOW_CAMPAIGN_REGRESSOR_MODEL_NAME=campaign-kpi-regressor
MLFLOW_CAMPAIGN_CLUSTERING_MODEL_NAME=campaign-segmentation-kmeans

# Optional local notebook snapshot files
SUPPLIER_NOTEBOOK_DATASET_PATH=supplier_feature_dataset.parquet
SELL_NOTEBOOK_DATASET_PATH=sell_feature_dataset.parquet
PROMOTE_NOTEBOOK_DATASET_PATH=promote_feature_dataset.parquet
