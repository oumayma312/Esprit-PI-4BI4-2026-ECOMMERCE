    "q1, q3 = y_clean.quantile([0.25, 0.75])\n",
    "iqr = q3 - q1\n",
    "lower, upper = q1 - 1.5 * iqr, q3 + 1.5 * iqr\n",
    "outlier_mask = (y_clean < lower) | (y_clean > upper)\n",
    "print(f\"Outliers by IQR rule: {int(outlier_mask.sum())} days ({outlier_mask.mean()*100:.1f}%) — kept\")\n",
